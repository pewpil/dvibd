generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  runtime                = "deno"
  importFileExtension    = "mts"
  generatedFileExtension = "mts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

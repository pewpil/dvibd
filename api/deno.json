{
  "tasks": {
    "db:generate": "deno run --allow-read --allow-write --allow-env --allow-net --allow-sys --allow-run --env-file=.env npm:prisma generate",
    "db:migrate": "deno run --allow-env --allow-sys --allow-read --allow-write --allow-run --env-file=.env npm:prisma migrate dev --name init",
    "db:reset": "deno run --allow-env --allow-sys --allow-read --allow-write --allow-run --env-file=.env npm:prisma migrate reset",
    "dev": "deno run -A --watch --env-file=.env ./src/index.ts"
  },
  "imports": {
    "@da/bcrypt": "jsr:@da/bcrypt@^1.0.1",
    "@hono/hono": "jsr:@hono/hono@^4.12.32",
    "@prisma/adapter-pg": "npm:@prisma/adapter-pg@^7.9.1",
    "@prisma/client": "npm:@prisma/client@^7.9.1",
    "@std/assert": "jsr:@std/assert@1",
    "@zod/zod": "jsr:@zod/zod@^4.4.3"
  }
}

generator api-client {
  provider               = "prisma-client"
  output                 = "../../api/src/generated"
  runtime                = "deno"
  importFileExtension    = "mts"
  generatedFileExtension = "mts"
}

generator gui-client {
  provider               = "prisma-client"
  output                 = "../../gui/src/generated"
  runtime                = "workerd"
  importFileExtension    = "mts"
  generatedFileExtension = "mts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  username      String         @unique
  email         String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  jti       String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?
}
.settings/

# Temp
gitignore

# curl cookie jars written by local verification probes. These carry live
# message.session refresh JWTs and must never be committed. See AGENTS.md
# > Cross-Coding Standards 5.
/c.txt
/m.txt
localhost_*.txt

# System Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Vite cache (if a standalone cache dir appears)
*.vite*

# ORM
dvibd/api/src/generated
dvibd/gui/src/generated

# exec runtime state and dev logs (see ./exec --help)
.exec/

# Agent skills
# Most are regenerable from the tracked skills-lock.json. See AGENTS.md > ORM & DB Standards > Prisma Skills.
# Hand-written skills are tracked and must NOT be removed. Add them here as exceptions.
.agents/skills/*
!.agents/skills/sticky-scroll-headers/


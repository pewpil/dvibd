{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "model": "opencode/deepseek-v4.1-flash-free",
  "mcp": {
    "servers": {
      "penpot": {
        "type": "remote",
        "url": "https://design.penpot.app/mcp/stream",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {file:penpot.key}"
        }
      }
    }
  }
}

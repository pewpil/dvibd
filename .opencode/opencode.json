{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "model": "opencode/deepseek-v4.1-flash-free",
  "mcp": {
    "servers": {
      "laravel-boost": {
        "type": "local",
        "command": [
          "php",
          "artisan",
          "boost:mcp"
        ],
        "cwd": "{env:HOME}/Projects/dvibd/pics"
      },
      "figcraft": {
        "type": "local",
        "command": [
          "{env:HOME}/.local/bin/figcraft-cli",
          "mcp",
          "--automation-read-root",
          "{env:HOME}/Projects/dvibd",
          "--automation-write-root",
          "{env:HOME}/Projects/dvibd"
        ]
      },
      "photocraft": {
        "type": "local",
        "command": [
          "{env:HOME}/.local/bin/photocraft-cli",
          "mcp",
          "--automation-read-root",
          "{env:HOME}/Projects/dvibd",
          "--automation-write-root",
          "{env:HOME}/Projects/dvibd"
        ]
      },
      "vectorcraft": {
        "type": "local",
        "command": [
          "{env:HOME}/.local/bin/vectorcraft-cli",
          "mcp",
          "--automation-read-root",
          "{env:HOME}/Projects/dvibd",
          "--automation-write-root",
          "{env:HOME}/Projects/dvibd"
        ]
      }
    }
  }
}
